  {
    "id": "T-63",
    "thread_id": "M-cascade-2026-08-14",
    "kind": "transcript_turn",
    "direction": "outbound",
    "contact": { "name": "Engagement Lead", "role": "Engagement Lead", "org": "Us" },
    "date": "2026-08-14",
    "meeting": { "title": "Cascade Recovery Discussion", "date": "2026-08-14" },
    "seq": 7,
    "text": "We'll have a full plan with dates by end of week."
  },
  {
    "id": "T-64",
    "thread_id": "M-cascade-2026-08-14",
    "kind": "transcript_turn",
    "direction": "inbound",
    "contact": { "name": "Marcus Webb", "role": "Analytics Manager", "org": "Meridian Holdings" },
    "date": "2026-08-14",
    "meeting": { "title": "Cascade Recovery Discussion", "date": "2026-08-14" },
    "seq": 8,
    "text": "I need to see that translate into actual dates, not just process changes. My credibility with my VP is on the line here too."
  },
  {
    "id": "T-65",
    "thread_id": "M-cascade-2026-08-14",
    "kind": "transcript_turn",
    "direction": "outbound",
    "contact": { "name": "Engagement Lead", "role": "Engagement Lead", "org": "Us" },
    "date": "2026-08-14",
    "meeting": { "title": "Cascade Recovery Discussion", "date": "2026-08-14" },
    "seq": 9,
    "text": "We hear that, and we're not taking it lightly."
