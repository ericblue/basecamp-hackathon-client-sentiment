    "id": "T-80",
    "thread_id": "M-delta-2026-07-29",
    "kind": "transcript_turn",
    "direction": "inbound",
    "contact": { "name": "Elena Vasquez", "role": "Program Sponsor", "org": "Meridian Holdings" },
    "date": "2026-07-29",
    "meeting": { "title": "Delta Escalation Call", "date": "2026-07-29" },
    "seq": 12,
    "text": "Do that. Right now I have no confidence this fixes itself without daily attention."
  },
  {
    "id": "T-81",
    "thread_id": "M-delta-2026-08-22",
    "kind": "transcript_turn",
    "direction": "outbound",
    "contact": { "name": "Engagement Lead", "role": "Engagement Lead", "org": "Us" },
    "date": "2026-08-22",
    "meeting": { "title": "Delta Pre-QBR Sync", "date": "2026-08-22" },
    "seq": 1,
    "text": "Ahead of the QBR next week, I wanted to sync on where things stand from your side."
  },
