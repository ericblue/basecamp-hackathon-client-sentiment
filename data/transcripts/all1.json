  {
    "id": "T-59",
    "thread_id": "M-cascade-2026-08-14",
    "kind": "transcript_turn",
    "direction": "outbound",
    "contact": { "name": "Engagement Lead", "role": "Engagement Lead", "org": "Us" },
    "date": "2026-08-14",
    "meeting": { "title": "Cascade Recovery Discussion", "date": "2026-08-14" },
    "seq": 3,
    "text": "That's fair feedback, we'll tighten up the daily standups."
