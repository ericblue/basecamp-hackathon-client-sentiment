  {
    "id": "T-61",
    "thread_id": "M-cascade-2026-08-14",
    "kind": "transcript_turn",
    "direction": "outbound",
    "contact": { "name": "Engagement Lead", "role": "Engagement Lead", "org": "Us" },
    "date": "2026-08-14",
    "meeting": { "title": "Cascade Recovery Discussion", "date": "2026-08-14" },
    "seq": 5,
    "text": "Understood. We're proposing to add a second engineer through the end of the month to close the gap."
  },
  {
    "id": "T-62",
    "thread_id": "M-cascade-2026-08-14",
    "kind": "transcript_turn",
    "direction": "inbound",
    "contact": { "name": "Marcus Webb", "role": "Analytics Manager", "org": "Meridian Holdings" },
    "date": "2026-08-14",
    "meeting": { "title": "Cascade Recovery Discussion", "date": "2026-08-14" },
    "seq": 6,
    "text": "That's a start. What does the updated timeline actually look like?"
