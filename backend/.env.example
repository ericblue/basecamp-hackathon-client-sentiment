# Key from the Base Camp key server: https://basecamp-key-server.onrender.com/
# Copy to backend/.env (gitignored) and fill in. Same var name in Render's env vars.
ANTHROPIC_API_KEY=

# Only if the Base Camp key is a gateway/proxy key rather than a direct sk-ant-... key.
# The SDK reads this automatically; leave unset for a real Anthropic key.
# ANTHROPIC_BASE_URL=

# Optional overrides
# SCORING_MODEL=claude-sonnet-5
# BRIEF_MODEL=claude-sonnet-5
# DATA_DIR=../data
